# Generate a random hex password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex
# npm run password --silent < /path/to/temporary-password-input
# Quote the hash so Compose preserves its dollar signs literally.
STUDIO_PASSWORD_HASH='replace-with-scrypt-hash'
STUDIO_ORIGIN=http://localhost:4317
STUDIO_PORT=4317
# Number of trusted reverse proxies in front of the studio (0-10). Default 0 keys the
# login throttle on the socket address; behind a proxy that is one shared bucket for
# everyone. Set to 1 for a single proxy that appends to X-Forwarded-For. Never set it
# higher than the real proxy count, or clients can spoof their address.
STUDIO_TRUST_PROXY=0
