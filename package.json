{
  "name": "writers-rolltop-server",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0"
  },
  "workspaces": [
    "packages/document-adapter"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit",
    "start": "node packages/studio/src/main.ts",
    "password": "node packages/studio/src/password-cli.ts",
    "test": "node --test packages/document-adapter/test/*.test.ts packages/studio/test/*.test.ts",
    "format": "prettier --write apps/web packages/studio scripts/container-smoke.ts scripts/preview-scratch.ts docs package.json tsconfig.json compose.yaml"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-unique-id": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
